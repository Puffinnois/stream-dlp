{
  "manifest_version": 3,
  "name": "stream-dlp YouTube session (experimental)",
  "version": "0.1.0",
  "description": "Sends your YouTube session from this browser profile to the stream-dlp app on this computer, only when you press Connect.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["cookies", "nativeMessaging"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "stream-dlp", "default_popup": "popup.html" }
}
